# Comma-separated list of Twitch channel names to monitor (required)
CHANNELS=channelname1,channelname2

# Directory where VOD files are stored inside the container (default: /data)
DATA_DIR=/data

# Optional: display path prefix for email links (e.g. your NAS share path)
# VOD_REAL_PATH=/mnt/mynas/twitch_vods

# SMTP email notifications (all optional — omit to disable email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
SMTP_TO=you@gmail.com
